    { "type": "h1", "text": "关键时刻识别卡" },
    { "type": "spacer", "pt": 16 },
    { "type": "h2", "text": "关键时刻的定义" },
    { "type": "body", "text": "客户与企业接触的任何一个时间点，客户可能凭借自己的感受对企业的服务质量做出评判，这个时间点就是关键时刻。" },
    { "type": "spacer", "pt": 20 },
    { "type": "h2", "text": "三要素" },
    { "type": "numbered", "text": "客户有期望/需求" },
    { "type": "numbered", "text": "客户与企业发生接触" },
    { "type": "numbered", "text": "客户在此刻形成感受判断" },
    { "type": "spacer", "pt": 20 },
    { "type": "h2", "text": "何时识别" },
    { "type": "bullet", "text": "客户首次接触服务时" },
    { "type": "bullet", "text": "客户提出问题或投诉时" },
    { "type": "bullet", "text": "服务交付的关键节点" },
    { "type": "bullet", "text": "服务结束后的跟踪回访" },
    { "type": "pagebreak" },
    { "type": "h2", "text": "关键时刻的价值" },
    { "type": "callout", "text": "关键时刻是客户感受服务的窗口，每一个关键时刻都在塑造客户对企业的整体印象。" },
    { "type": "spacer", "pt": 24 },
    { "type": "h2", "text": "识别后的行动" },
    { "type": "bullet", "text": "立即关注这一时刻的客户感受" },
    { "type": "bullet", "text": "记录关键接触点" },
    { "type": "bullet", "text": "分析客户在此刻的需求" },
    { "type": "bullet", "text": "为后续服务改进提供依据" },
    { "type": "spacer", "pt": 40 },
    { "type": "divider" },
