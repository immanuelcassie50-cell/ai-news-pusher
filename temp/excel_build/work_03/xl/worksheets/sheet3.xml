  <c r="C26" s="14" t="inlineStr"><is><t>标准化/5</t></is></c>
</row>
  <row r="27">
  <c r="A27" s="13" t="inlineStr"><is><t>AI协作力</t></is></c>
  <c r="B27" s="21"><f>B16</f><v></v></c>
  <c r="C27" s="21"><f>B16/20*5</f><v></v></c>
</row>
  <row r="28">
  <c r="A28" s="13" t="inlineStr"><is><t>人类深度</t></is></c>
