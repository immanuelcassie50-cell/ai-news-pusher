{
  "title": "课堂检验设计卡",
  "type": "minimal",
  "author": "课程开发组",
  "date": "2026",
  "accent": "#C41E3A",
  "content": [
    {"type": "h1", "text": "如何检验学员学习效果"},
    {"type": "callout", "text": "检验是带教闭环的关键，没有检验的带教是无效的"},
    {"type": "h2", "text": "知识检验：提问法"},
    {"type": "bullet", "text": "方式：口头提问 + 书面测试"},
    {"type": "bullet", "text": "问题类型：事实性问题 + 理解性问题 + 应用性问题"},
    {"type": "bullet", "text": "要点：问题要明确，答案要具体"},
    {"type": "h2", "text": "技能检验：实操法"},
    {"type": "bullet", "text": "方式：模拟练习 + 实际任务"},
    {"type": "bullet", "text": "评估标准：操作步骤 + 完成质量 + 时间效率"},
    {"type": "bullet", "text": "要点：标准要清晰，反馈要及时"},
    {"type": "h2", "text": "态度检验：观察法"},
    {"type": "bullet", "text": "方式：行为观察 + 态度量表"},
    {"type": "bullet", "text": "观察点：主动性 + 责任心 + 团队协作"},
    {"type": "bullet", "text": "要点：记录具体行为，避免主观臆断"},
    {"type": "h2", "text": "综合检验：情境模拟"},
    {"type": "bullet", "text": "方式：完整情境 + 综合任务"},
    {"type": "bullet", "text": "评估维度：知识运用 + 技能展示 + 态度表现"},
    {"type": "bullet", "text": "要点：情境要真实，评估要全面"},
    {"type": "divider"},
    {"type": "body", "text": "背面使用说明：本卡片提供四种检验方法。建议在带教过程中穿插使用，初期以知识检验为主，中期以技能检验为主，后期以综合检验为主。"}
  ]
}
