<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  workbook.xml — Defines the list of sheets.

  To add a new sheet:
    1. Add a <sheet> element below with a unique sheetId and r:id
    2. Add a matching <Relationship> in xl/_rels/workbook.xml.rels
    3. Add an <Override> in [Content_Types].xml
    4. Create the xl/worksheets/sheetN.xml file

  Sheet name rules:
    - Max 31 characters
    - Cannot contain: / \ ? * [ ] :
    - Ampersand must be escaped as &amp; in XML
-->
<workbook
  xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"
  xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">
  <fileVersion appName="xl" lastEdited="7" lowestEdited="7"/>
  <workbookPr defaultThemeVersion="166925"/>
  <bookViews>
    <workbookView xWindow="0" yWindow="0" windowWidth="20140" windowHeight="10960"/>
  </bookViews>
  <sheets>
    <sheet name="F01_PERMA基准线自评表" sheetId="1" r:id="rId4"/>
    <sheet name="F02_情绪词汇积累表" sheetId="2" r:id="rId5"/>
    <sheet name="F03_VIA优势自评表" sheetId="3" r:id="rId6"/>
    <sheet name="F04_感恩三件事记录表" sheetId="4" r:id="rId7"/>
    <sheet name="F05_心流触发器识别表" sheetId="5" r:id="rId8"/>
    <sheet name="F06_个人充值菜单表" sheetId="6" r:id="rId9"/>
    <sheet name="F07_认知扭曲识别表" sheetId="7" r:id="rId10"/>
    <sheet name="F08_ABCDE重构工作表" sheetId="8" r:id="rId11"/>
    <sheet name="F09_韧性叙事模板" sheetId="9" r:id="rId12"/>
    <sheet name="F10_幸福例程设计表" sheetId="10" r:id="rId13"/>
  </sheets>
  <!-- calcId ensures Excel recalculates formulas on open -->
  <calcPr calcId="191029"/>
</workbook>
